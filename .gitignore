# ===== Layout Designer — .gitignore =====

# --- Node / Electron ---
node_modules/
dist/
out/
release/
*.tgz

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- Test outputs ---
tests/playwright/test-results/
tests/playwright/playwright-report/
coverage/

# --- Caches ---
.npm
.eslintcache
.cache/

# --- Python (cli_tools) ---
__pycache__/
*.pyc
.pytest_cache/

# --- OS / éditeur ---
.DS_Store
Thumbs.db

# Patch files delivered into the repo folder (never commit them)
*.patch

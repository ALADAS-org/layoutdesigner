														"position": ["0.25", "0.25"], "size": 0.48, "fillColor": "black" },
													{ 	"type": "circle", "drawColor": "none",
														"position": ["0.25", "0.25"], "size": 0.30, "fillColor": "orange" },
													{ 	"type": "circle", "drawColor": "none",
														"position": ["0.25", "0.75"], "size": 0.48, "fillColor": "magenta" },
													{ 	"type": "circle", "drawColor": "none",
														"position": ["0.25", "0.75"], "size": 0.24, "fillColor": "white" },
													"$BottomRightDigitMark"
												]

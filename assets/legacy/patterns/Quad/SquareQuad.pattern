{
	"Name"					:   "SquareQuad",
	"Description"           :   "Demo pattern with square shapes inside cell quarters",
	"Tags"                  :   "Quad",
	"Schema"				: 	"pattern.schema",
    "CellSize"              : 	"25",
	"MaxCellValue"          : 	"7",
    "CellValueMode"         : 	"Random",
    "BackgroundColor"       : 	"#796d80",
	
	"Shapes"				: 	{ 	"0":	{ 	"type": "SquareQuadCell",
												"decoration": "centerSubsquare", 
												"decorationColorChoices": [ "white", "red", "cyan", "black", "yellow", "green" ],
												"colorPairs": [ "none+none", "none+none", "none+none", "none+none" ]
											},										
									"1":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "none+none", "none+none", "pink+black" ] 
											},
									"2":	{ 	"type": "SquareQuadCell",								
												"colorPairs": [ "none+none", "none+none", "cyan+white", "none+none" ] 
											},
									"3":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "none+none", "red+white", "cyan+lightgrey" ] 
											},
									"4":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "red+yellow", "none+none", "none+none" ] 
											},										
									"5":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "white+brown", "none+none", "orange+#7bed9a"  ] 
											},
									"6":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "green+white", "red+lightgreen", "none+none" ] 
											},
									"7":	{ 	"type": "SquareQuadCell", 
												"colorPairs": [ "none+none", "red+white", "yellow+pink", "black+yellow" ] 
											}
								}							
}
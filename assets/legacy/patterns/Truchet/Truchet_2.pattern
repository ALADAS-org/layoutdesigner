										]
									},
							"C":	{   "type": "ComboShape",
										"parts": [
                                            "$NorthDot", "$HorizontalBar", 
                                            "$E2SArc", "$S2WArc",												
											"$DigitMark"
										]
									},
							"D":	{   "type": "ComboShape",
										"parts": [
										    "$N2EArc", "$E2SArc",
                                            "$VerticalBar", 												
											"$DigitMark"
										]
									},
							"E":	{   "type": "ComboShape",
										"parts": [
										    "$S2WArc", "$W2NArc",
                                            "$VerticalBar", 												
											"$DigitMark"
										]
									}									
						}								
}									  											  												  
											"$HorizontalBar",												
											"$SouthDot", "$DigitMark"
										]
									},
                            "3":	{   "type": "ComboShape",
										"parts": [
                                            "$TwoDotsWE",										
											"$VerticalBar",												
											"$DigitMark"
										]
									},		
							"4":	{   "type": "ComboShape",
										"parts": [												  
                                            "$TwoDotsNE", "$TwoDotsSW",											
											"$DigitMark"
										]
									},
                            "5":	{   "type": "ComboShape",
										"parts": [												  
                                            "$N2EArc", "$S2WArc",
											"$W2NArc", "$E2SArc",
                                            "$VerticalBar", "$HorizontalBar",											
											"$DigitMark"
										]
									},
							"6":	{   "type": "ComboShape",
										"parts": [	
											"$VerticalBar", "$HorizontalBar",										
											"$DigitMark"
										]
									},
							"7":	{   "type": "ComboShape",
										"parts": [
                                            "$N2EArc", "$TwoDotsSW",											
											"$DigitMark"
										]
									},
							"8":	{   "type": "ComboShape",
										"parts": [
                                            "$S2WArc", "$TwoDotsNE",											
											"$DigitMark"
										]
									},
							"9":	{   "type": "ComboShape",
										"parts": [
                                            "$W2NArc", "$TwoDotsES",											
											"$DigitMark"
										]
									},
							"A":	{   "type": "ComboShape",
										"parts": [
                                            "$E2SArc", "$TwoDotsWN",											
											"$DigitMark"
										]
									},
							"B":	{   "type": "ComboShape",
										"parts": [
                                            "$W2NArc", "$N2EArc",
											"$HorizontalBar", "$SouthDot",												

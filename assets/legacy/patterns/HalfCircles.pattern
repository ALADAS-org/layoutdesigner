{
	"Name"                  : "HalfCircles",
	"Description"		    : "HalfCircles composition in Black & White",
	"Reference"				: "Computer Graphics and Art May 76 page 17",
    "CellSize"              : "25",
	"MaxCellValue"          : "7",
	"GridColor"             : "cyan",
    "CellValueMode"         : "Random",
	"NumberFormat"			: "absolute",
    "BackgroundColor"       : "black",
	
	"Variables"             : { "ColoredDigitMark(draw_color)": 
	                                            { "type": "digit_mark", "drawColor": "$draw_color", 
	                                              "drawThickness": 0.3, "position": ["4", "5"] },
												  
								"RightHalfCircle(circle_color,bg_color)":
                                                [ { "type": "square", "size": 25, 
												    "fillColor": "$bg_color", "drawColor": "none" },	
												  
												  { "type": "arc", "fillColor": "$circle_color", "fillStyle": "PIE",
												    "drawColor": "#999999", "drawThickness": 0.5,
												    "position": ["12.5", "0"], "size": 25,
												    "startAngle": 0, "endAngle": 180, "rotation": 90 }
                                                ],

								"LeftHalfCircle(circle_color,bg_color)":
                                                [ { "type": "square", "size": 25, 
												    "fillColor": "$bg_color", "drawColor": "none" },
											
												  { "type": "arc", "fillColor": "$circle_color", "fillStyle": "PIE",
												    "drawColor": "$circle_color", "drawThickness": 0.5,
												    "position": ["-12.5", "0"], "size": 25,
												    "startAngle": 0, "endAngle": 180, "rotation": 270 }
                                                ]												
							  },
							  
	"Shapes"				: { "0":	{   "type": "ComboShape", 
											"parts": [	
												{ "type": "arc", "fillColor": "#DADADA", "fillStyle": "PIE",
												  "drawColor": "#DADADA", "drawThickness": 0.33,
												  "position": ["0", "-12.5"], "size": 25,
												  "startAngle": 0, "endAngle": 180 },
												  
												"$ColoredDigitMark('black')"
											]
										},
								"1":	{	"type": "ComboShape",
											"parts": [	
											    { "type": "square", "size": 25, 
												  "fillColor": "white", "drawColor": "none" },
														  
												{ "type": "arc", "fillColor": "#999999", "fillStyle": "PIE", 
												  "drawColor": "#999999", "drawThickness": 0.33,
												  "position": ["0", "12.5"], "size": 25,
												  "startAngle": 0, "endAngle": 180, "rotation": 180 },
												  
												"$ColoredDigitMark('black')"
											]
										},
                                "2":	{   "type": "ComboShape", 
											"parts": [
                                                "$RightHalfCircle('#DADADA','black')",											
												"$ColoredDigitMark('white')"
											]
										},
                                "3":	{   "type": "ComboShape", 
											"parts": [
											    "$RightHalfCircle('#999999','white')",
												"$ColoredDigitMark('black')"
											]
										},
                                "4":	{   "type": "ComboShape", 
											"parts": [	
											    "$LeftHalfCircle('white','black')", 
												"$ColoredDigitMark('black')"
											]
										},
                                "5":	{   "type": "ComboShape", 
											"parts": [
											    "$LeftHalfCircle('black','white')",
												"$ColoredDigitMark('white')"
											]
										},
                                "6":	{   "type": "ComboShape", 
											"parts": [
                                                { "type": "square", "size": "25", 
												  "fillColor": "white", "drawColor": "none" },
												  
												{ "type": "arc", "fillColor": "black", "fillStyle": "PIE",
												  "drawColor": "black", "drawThickness": 0.1,
												  "position": ["12.5", "0"], "size": 25,
												  "startAngle": 0, "endAngle": 180, "rotation": 90 },
											
												{ "type": "arc", "fillColor": "black", "fillStyle": "PIE",
												  "drawColor": "black", "drawThickness": 0.1,
												  "position": ["-12.5", "0"], "size": 25,
												  "startAngle": 0, "endAngle": 180, "rotation": 270 },
												  
												"$ColoredDigitMark('white')"
											]
										},
                                "7":	{   "type": "ComboShape", 
											"parts": [
                                                { "type": "square", "size": "25", 
												  "fillColor": "white", "drawColor": "none" },
												  
												{ "type": "arc", "fillColor": "#999999", "fillStyle": "PIE",
												  "drawColor": "#999999", "drawThickness": 0.1,
												  "position": ["0", "-12.5"], "size": 25,
												  "startAngle": 0, "endAngle": 180 },
												  
												{ "type": "arc", "fillColor": "#999999", "fillStyle": "PIE", 
												  "drawColor": "#999999", "drawThickness": 0.1,
												  "position": ["0", "12.5"], "size": 25,
												  "startAngle": 0, "endAngle": 180, "rotation": 180 },
												  
												"$ColoredDigitMark('white')"
											]
										}
							  }							
}
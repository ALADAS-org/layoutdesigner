{
  // Renderer: ES modules in Chromium, DOM types, no Node.js.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["plugins/*/renderer.js", "src/renderer/**/*.js", "src/vizjets/**/*.js", "src/types/**/*.d.ts"]
}
